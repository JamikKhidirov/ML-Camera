# Скопируй в .env и заполни. Файл .env не попадает в git.
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)

# Порт панели на хосте (внутри контейнера всегда 8088).
MLCAMERA_PORT=8088

# RTSP-камера. Если оставить пустым — берётся список cameras из config/config.yaml.
# Формат: rtsp://ЛОГИН:ПАРОЛЬ@192.168.1.100:554/stream1
MLCAMERA_CAMERA_SOURCE=
MLCAMERA_CAMERA_NAME=Двор

# FPS камеры: 0 — не ограничивать, 30 — плавно, 15 — экономия CPU.
MLCAMERA_CAMERA_FPS=30

# 1 — если IP-камера не открылась, подключать веб-камеру (в контейнере её нет).
MLCAMERA_FALLBACK_WEBCAM=0

# Пароль панели. Обязательно задай, если сервер смотрит в интернет.
MLCAMERA_WEB_TOKEN=

# Часовой пояс и число потоков CPU.
TZ=Europe/Moscow
OMP_NUM_THREADS=2
